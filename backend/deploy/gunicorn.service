[Unit]
Description=SAN HYDRO backend (gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sanhydro/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sanhydro/backend/venv/bin/gunicorn config.wsgi:application \
  --bind 127.0.0.1:8009 \
  --workers 3 \
  --timeout 60 \
  --access-logfile - \
  --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
